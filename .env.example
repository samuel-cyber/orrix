PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Console login. Required: without it the UI refuses every login.
# Hashed once at startup; the plain value is not kept in memory.
ADMIN_PASSWORD=

# Optional. Signs CSRF tokens. A random value is generated per start when
# unset, which logs everyone out on restart.
# SESSION_SECRET=
# SESSION_TTL_SECONDS=28800
# Set when serving over HTTPS so the session cookie carries Secure.
# SECURE_COOKIES=false
# PORT=8010

# Reader model access. Read by the caller (scripts/run_reader.py), which
# builds a ReaderConfig; orrix/reader.py never reads the environment itself.
READER_API_KEY=
# READER_BASE_URL=https://api.openai.com/v1
# READER_MODEL=gpt-4o-mini
# READER_TIMEOUT=30
# READER_MAX_RETRIES=2

# The evaluation harness reads its model credentials from a file you pass
# with --env-file, so a second provider can live outside .env entirely:
#
#   cp .env.example .env.meta   # then set the three READER_* keys below
#   python -m attacks.run --live --n 3 --yes --label meta-<model> \
#       --env-file .env.meta --max-calls 400
#
# .env.meta and every .env.* file is git-ignored. The key is read in the CLI,
# passed down as a config object, and never logged.

# Optional AG Grid Enterprise licence. Read into AppConfig and injected into
# the page at render time, so the grid runs without a watermark. Leave empty
# and everything still works, watermark included. Never commit this value;
# .env is git-ignored and the key is kept out of logs and config reprs.
# AG_GRID_LICENSE_KEY=

# Optional. Where the attack harness writes its summary, and the notes whose
# caveats the /evaluation page shows beside the numbers.
# ORRIX_RESULTS_PATH=results/summary.json
# ORRIX_RESULTS_NOTES_PATH=docs/RESULTS.md

# Optional. Keys the audit chain with HMAC-SHA256 so forging an entry needs
# the key as well as database access. Read by the caller into AuditConfig.
# Store it somewhere the process that writes the database cannot read; a key
# next to the log buys little. See docs/THREAT_MODEL.md.
# AUDIT_HMAC_KEY=

# Optional. Bearer token for machine ingest at POST /api/orders, where a
# warehouse or ERP system posts order rows. Compared in constant time and
# rate-limited per minute. Unset disables the endpoint, so nothing may be
# ingested; the operator's /orders form and CSV import need a session, not
# this token. The value is never logged or echoed.
# LEDGER_API_KEY=
# LEDGER_MAX_PER_MINUTE=60

# Carrier connector. OFF by default, and off means off: no client is built,
# no lookup is attempted, no carrier fact is added and the case page shows no
# carrier card, so the deployment behaves exactly as it did without it.
#
# A carrier response is untrusted input. Only a status enum, a delivery
# timestamp, the time of the check and the provider's name are kept; every
# free-text field the provider returns is dropped and never stored. A
# carrier reading is "carrier-reported", never "verified", and it never
# changes what policy permits.
#
# CARRIER_API_PROVIDER accepts "aftership" (the one implemented adapter) or
# "none". The key is sent in a header, never logged, and never committed.
# CARRIER_ENABLED=false
# CARRIER_API_PROVIDER=none
# CARRIER_API_KEY=
# CARRIER_TIMEOUT_SECONDS=10
# CARRIER_MAX_LOOKUPS_PER_HOUR=60

# Optional. Defaults shown.
# ORRIX_DB_PATH=orrix.db
# POLLER_ENABLED=true
# POLL_INTERVAL_SECONDS=60
